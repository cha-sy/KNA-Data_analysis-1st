# 종합실습 2. 2단계 조건분류
def group_rows_by_category(rows, category_index=0):
    # """
    # 지정한 인덱스(기본값: 0번째 열, 부품/설비명)를 기준 키(Key)로 삼아
    # 데이터를 그룹별 딕셔너리로 분류합니다.
    # """
    grouped_data = {}
    for row in rows:
        if not row:
            continue
        category = row[category_index].strip()
        if category not in grouped_data:
            grouped_data[category] = []
        grouped_data[category].append(row)

    print(
        f"[STEP 2 성공] 총 {len(grouped_data)}개 카테고리/설비로 분류 완료 ({', '.join(grouped_data.keys())})"
    )
    return grouped_data


# 종합실습 3. 통계함수
def calc_stats(values):
    numbers = []
    for v in values:
        try:
            numbers.append(float(v))
        except ValueError:
            continue
    if len(numbers) == 0:
        return None
    count = len(numbers)
    average = sum(numbers) / count
    return {
        "count": count,
        "average": average,
        "min": min(numbers),
        "max": max(numbers),
    }


sample_stats = calc_stats(["0.0", "2939.61", "결측", "4366.23"])
print(sample_stats)  # {'count': 3, 'average': 2435.28, 'min': 0.0, 'max': 4366.23}

empty_stats = calc_stats(["결측", ""])
print(empty_stats)


