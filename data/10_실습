# 종합실습 1. -1단계 csv 읽기
import os
import csv

dirty_csv_path = os.path.join("data", "09_ict_inspection_dirty.csv")


def read_ict_csv(path):
    try:
        with open(path, "r", encoding="utf-8") as f:
            reader = csv.reader(f)
            header = next(reader)
            rows = []
            for row in reader:
                if len(row) > 0:
                    rows.append(row)
            return header, rows
    except FileNotFoundError:
        print(f"파일을 찾을 수 없습니다: {path}")
        return [], []


